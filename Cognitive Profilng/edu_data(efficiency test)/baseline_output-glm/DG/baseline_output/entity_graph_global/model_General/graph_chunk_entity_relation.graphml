    <node id="&quot;IF (STD::ABS(E) &lt; 1)&lt;BR&gt;        IF (X % 3 == 0)&lt;BR&gt;            E = (X &gt; 0) ? (X / 3 + 1) : (X / 3 - 1);&lt;BR&gt;        ELSE&lt;BR&gt;            E = (X &gt; 0) ? (X / 3 + (X % 3 &gt; 0)) : (X / 3 - (X % -3 &lt; 0));&quot;">
