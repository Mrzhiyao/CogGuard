    <edge source="&quot;INPUT_OUTPUT_AND_SEQUENTIAL_STRUCTURE&quot;" target="&quot;[RECORD ID: 14-1, TIMESTAMP: 2024-10-13 19:29:31]&quot;">
      <data key="d3">7.0</data>
