    <edge source="&quot;SOLVE(INT X)&quot;" target="&quot;STD::COUT &lt;&lt; D &lt;&lt; &quot; &quot; &lt;&lt; 1 &lt;&lt; &quot; &quot; &lt;&lt; E &lt;&lt; STD::ENDL;&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"This output event is part of the actions performed by the solve(int x) function and uses the variable 'e' calculated earlier."</data>
