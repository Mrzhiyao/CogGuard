      <data key="d0">"EVENT"</data>
      <data key="d1">"The exact date and time when the student submission was recorded, providing temporal context for the evaluation."</data>
      <data key="d2">chunk-d4db67f6f26be9e4b4ab88e308dd16a1</data>
    </node>
    <node id="&quot;RECORD ID: 45-1&quot;">
