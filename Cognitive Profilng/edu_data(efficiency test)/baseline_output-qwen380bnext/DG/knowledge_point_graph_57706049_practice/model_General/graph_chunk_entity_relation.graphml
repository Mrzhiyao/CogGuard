      <data key="d3">7.0</data>
      <data key="d4">"sum[0][i] precomputes diagonal sums that correspond to one arm of the Dragon's Breath 'X' pattern."</data>
      <data key="d5">chunk-9dfc436139fa6006082f3b7f4127742f</data>
      <data key="d6">1</data>
