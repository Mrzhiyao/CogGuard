      <data key="d6">1</data>
    </edge>
    <edge source="&quot;BOUNDARY COUNT&quot;" target="&quot;ANS1 AND MIN VARIABLES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Min is updated based on Boundary Count (cnt2) to track the smallest boundary among the largest connected components, forming the core optimization criterion."</data>
      <data key="d5">chunk-d86f2da20705ac92182e4cb2383023c8</data>
      <data key="d6">1</data>
    </edge>
