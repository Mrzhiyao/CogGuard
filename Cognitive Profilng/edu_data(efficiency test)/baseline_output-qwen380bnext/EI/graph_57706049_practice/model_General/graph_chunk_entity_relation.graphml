      <data key="d4">"(3,3) 是蓝色极大连通块的一个组成单元，属于该事件的实体实例。"</data>
      <data key="d5">chunk-0bcd1771d7e55d80f714bbc3d88370bd</data>
      <data key="d6">1</data>
    </edge>
