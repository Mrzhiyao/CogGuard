    <edge source="&quot;学生程序&quot;" target="&quot;STD::SORT(A + 1, A + 1 + N, [](T A, T B) { RETURN A.L &lt; B.L ? A.L &lt; B.L : A.R &lt; B.R; })&quot;">
      <data key="d3">9.0</data>
