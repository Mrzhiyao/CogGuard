      <data key="d0">"EVENT"</data>
      <data key="d1">"Record ID: 76-1 是系统记录的唯一标识符，关联该学生提交、错误评估和时间戳（2025-01-24 16:25:10），用于追踪竞赛提交历史。"</data>
      <data key="d2">chunk-46766da85f9f13835e435950173174a4</data>
    </node>
