    <node id="&quot;PROBLEM: TOKITSUKAZE AND ABSOLUTE EXPECTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Problem: Tokitsukaze and Absolute Expectation is the named computational problem requiring the calculation of the expected value of the sum of absolute differences in a randomly generated integer sequence with bounded intervals."</data>
