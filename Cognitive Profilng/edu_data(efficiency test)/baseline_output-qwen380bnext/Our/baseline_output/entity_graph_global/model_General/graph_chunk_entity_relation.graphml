      <data key="d3">8.0</data>
      <data key="d4">"The loop index k iterates over columns in row i during the row-wise validation check of the matrix."</data>
      <data key="d5">chunk-c79d0a874a6ba47efd4742ec70c1e196</data>
      <data key="d6">1</data>
    </edge>
    <edge source="&quot;K&quot;" target="&quot;A[K][J]&quot;">
      <data key="d3">8.0</data>
