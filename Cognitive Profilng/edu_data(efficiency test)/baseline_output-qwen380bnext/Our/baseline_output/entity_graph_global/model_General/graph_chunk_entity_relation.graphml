    </edge>
    <edge source="&quot;DRAGON'S BREATH&quot;" target="&quot;SUM[1][I]&quot;">
      <data key="d3">17.0</data>
      <data key="d4">"sum[1][i] is a precomputed value used to efficiently calculate the total monsters destroyed along another diagonal of Dragon's Breath."&lt;SEP&gt;"sum[1][i] precomputes anti-diagonal sums to optimize the calculation of Dragon's Breath damage along the opposite diagonal direction."</data>
      <data key="d5">chunk-6ab3ebf5f1287dbbf9a2ec35fad95eea&lt;SEP&gt;chunk-89dd6bd1e7fef4152822627f117d0a69</data>
      <data key="d6">1</data>
    </edge>
