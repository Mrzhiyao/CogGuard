      <data key="d5">chunk-ea00e0f2c81dc0fc8cf34f9d8c29edd8</data>
      <data key="d6">1</data>
    </edge>
    <edge source="&quot;STUDENT&quot;" target="&quot;RECORD ID: 101-2&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The student is the subject of the submission identified by Record ID: 101-2, which tracks their performance on a specific problem."</data>
      <data key="d5">chunk-3c80b6ec9209aca37eecb346184a349b</data>
      <data key="d6">1</data>
    </edge>
    <edge source="&quot;STUDENT&quot;" target="&quot;PROBLEM&quot;">
      <data key="d3">19.0</data>
      <data key="d4">"The student attempts to solve a specific problem, and their submission is evaluated to determine mastery."&lt;SEP&gt;"The student engages with the problem by submitting a response, which is then evaluated for understanding."</data>
      <data key="d5">chunk-c8766ea63b59cbbc45f9300a452dd50e&lt;SEP&gt;chunk-3c80b6ec9209aca37eecb346184a349b</data>
