      <data key="d5">chunk-b80c6952ceb5bde1a528cf5c85d2c25a</data>
      <data key="d6">1</data>
    </edge>
    <edge source="&quot;MASTERY LEVEL&quot;" target="&quot;GOOD&quot;">
      <data key="d3">27.0</data>
      <data key="d4">"The 'Good' label directly determines a high mastery level for the student on this specific problem."&lt;SEP&gt;"The 'Good' label directly determines a high mastery level for the student on this specific submission."&lt;SEP&gt;"The 'Good' label is the manifestation of a high mastery level, assigned when no errors are detected in the submission."</data>
      <data key="d5">chunk-37700e6b965dc09fe5f8a9761da4d8f8&lt;SEP&gt;chunk-c8766ea63b59cbbc45f9300a452dd50e&lt;SEP&gt;chunk-725789acf7c08a6f0c7c8cab1e7f5ea4</data>
