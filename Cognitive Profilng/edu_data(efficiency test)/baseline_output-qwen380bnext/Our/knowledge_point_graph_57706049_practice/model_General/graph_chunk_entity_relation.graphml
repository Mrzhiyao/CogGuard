      <data key="d5">chunk-55785fde60a695d1127152a7469bca07</data>
      <data key="d6">1</data>
    </edge>
    <edge source="&quot;STUDENT&quot;" target="&quot;2025-02-08 13:43:29&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The student's submission occurred at the specific timestamp 2025-02-08 13:43:29, anchoring their performance to a precise moment in time."</data>
      <data key="d5">chunk-55785fde60a695d1127152a7469bca07</data>
      <data key="d6">1</data>
    </edge>
