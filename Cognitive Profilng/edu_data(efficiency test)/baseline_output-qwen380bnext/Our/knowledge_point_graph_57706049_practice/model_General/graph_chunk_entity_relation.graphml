    </edge>
    <edge source="&quot;STUDENT&quot;" target="&quot;MASTERY LEVEL&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"The student’s performance directly determines their mastery level for the problem, based on the presence or absence of errors."</data>
      <data key="d5">chunk-3c80b6ec9209aca37eecb346184a349b</data>
      <data key="d6">1</data>
    </edge>
    <edge source="&quot;STUDENT&quot;" target="&quot;KNOWLEDGE POINT&quot;">
      <data key="d3">15.0</data>
      <data key="d4">"The student is expected to demonstrate mastery of one or more knowledge points through their submission."&lt;SEP&gt;"The student’s understanding of each knowledge point is inferred from whether it is mentioned or implied in the error description."</data>
      <data key="d5">chunk-26b0d0ed2ff7cae6f89f08cce6fe3a3e&lt;SEP&gt;chunk-3c80b6ec9209aca37eecb346184a349b</data>
